[Unit]
After=graphical-session.target
Description=Vicinae app launcher
PartOf=graphical-session.target
# ConditionEnvironment=DESKTOP_SESSION=qtile
# Try to restart up to 3 times
StartLimitBurst=3
# Don't try to restart after 60 seconds
StartLimitIntervalSec=60

[Service]
ExecStart=vicinae server
ExecReload=vicinae server --reload
# Try to restart no matter how the process ended
Restart=never

[Install]
WantedBy=graphical-session.target
